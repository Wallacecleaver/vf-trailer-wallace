# ============================================================
# Référence des variables d'environnement (l'installeur de l'image génère le .env pour toi)
# ============================================================

# --- OBLIGATOIRE -------------------------------------------------------------

# Mot de passe de connexion au dashboard (/dashboard). 12 caractères minimum, aléatoire.
# Génère-le :  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# La connexion est refusée tant que ce mot de passe est absent, trop court ou « change-moi ».
DASHBOARD_PASSWORD=

# Secret de signature des sessions du dashboard (indépendant du mot de passe).
# Génère-le :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Absent = secret aléatoire généré au démarrage (les sessions ne survivent alors pas à un redémarrage).
TOKEN_SECRET=

# Adresse publique de ton addon, SANS slash final. Utilisée pour le logo et
# les liens (/proposer...) renvoyés dans Stremio.
#   en local :        http://localhost:3000
#   avec un domaine (reverse proxy HTTPS) : https://trailers.mondomaine.fr
APP_BASE_URL=http://localhost:3000

# --- RECOMMANDÉ --------------------------------------------------------------

# Ta clé TMDB (gratuite : https://www.themoviedb.org/settings/api).
# Réservée au testeur du dashboard : les utilisateurs de l'addon mettent la leur
# dans la page de configuration.
TMDB_API_KEY=

# --- RÉSEAU (optionnel) ------------------------------------------------------

# Ton reverse proxy HTTPS tourne sur cette même machine ? Ne publie plus le port de l'addon sur Internet :
# BIND_ADDRESS=127.0.0.1

# Nombre de reverse proxies de confiance devant l'addon. 0 par défaut : l'en-tête
# X-Forwarded-For est ignoré (falsifiable). Mets 1 (ou N) UNIQUEMENT si un reverse proxy
# de confiance est devant, sinon le verrouillage anti brute-force serait contournable.
# L'installeur le règle automatiquement.
# TRUST_PROXY=0

# Autorise une instance amont « Netflix Catalogue » sur une adresse privée (ex. http://netflix:7000
# entre conteneurs). Désactivé par défaut : le serveur refuse les URL internes (anti-SSRF).
# ALLOW_PRIVATE_UPSTREAM=1

# Port exposé sur la machine hôte (défaut 3000).
# HOST_PORT=3000

# Base SQLite : fichier addon.sqlite stocké dans DATA_DIR (/data dans l'image, à monter en volume).
# DATA_DIR=/data

# Dashboard : désactiver le cache de rendu (utile quand tu modifies dashboard/*)
# DASHBOARD_NO_CACHE=1

# --- NETFLIX CATALOGUE (optionnel) -------------------------------------------

# URL d'une instance de l'addon « Netflix Catalogue » qui expose ses bandes-annonces
# via /api/trailers. Aucune clé API : l'instance amont doit avoir API_KEY vide.
# Se règle aussi dans le dashboard (Réglages → API Netflix Catalogue).
# NETFLIX_CATALOGUE_URL=https://netflix.mondomaine.fr

