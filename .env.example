# ============================================================
# Configuration self-host — copie ce fichier en `.env` :  cp .env.example .env
# ============================================================

# --- OBLIGATOIRE -------------------------------------------------------------

# Mot de passe de connexion au dashboard (/dashboard). Choisis-en un long.
DASHBOARD_PASSWORD=change-moi

# Mot de passe de la base Postgres (lettres et chiffres uniquement, pour éviter
# tout souci de caractères spéciaux dans l'URL de connexion).
POSTGRES_PASSWORD=change-moi-aussi

# Adresse publique de ton addon, SANS slash final. Utilisée pour le logo et
# les liens (/proposer...) renvoyés dans Stremio.
#   en local :        http://localhost:3000
#   avec un domaine : https://trailers.mondomaine.fr
APP_BASE_URL=http://localhost:3000

# --- RECOMMANDÉ --------------------------------------------------------------

# Ta clé TMDB (gratuite : https://www.themoviedb.org/settings/api).
# Réservée au testeur du dashboard : les utilisateurs de l'addon mettent la leur
# dans la page de configuration.
TMDB_API_KEY=

# --- HTTPS AUTOMATIQUE (optionnel, profil « https » de docker-compose) -------

# Nom de domaine qui pointe vers ton serveur (DNS en A / AAAA).
# DOMAIN=trailers.mondomaine.fr
# Avec Caddy devant, ne publie plus le port de l'addon sur Internet :
# BIND_ADDRESS=127.0.0.1

# --- AVANCÉ (rarement utile) -------------------------------------------------

# Port exposé sur la machine hôte (défaut 3000).
# HOST_PORT=3000

# Redis Upstash facultatif (dédoublonnage des recherches, cache du statut des services).
# Sans lui, tout fonctionne ; ces deux fonctions sont simplement désactivées.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Utiliser une base Postgres externe au lieu de celle du docker-compose
# (dans ce cas, supprime le service `db` et la ligne DATABASE_URL de docker-compose.yml) :
# DATABASE_URL=postgres://user:motdepasse@hote:5432/base
# DATABASE_SSL=true            # si ton Postgres impose le SSL
# DB_DRIVER=pg                 # forcer le driver : pg (classique) ou neon (Neon hébergé)

# Dashboard : désactiver le cache de rendu (utile quand tu modifies dashboard/*)
# DASHBOARD_NO_CACHE=1
