# ============================================================
# Référence des variables d'environnement (l'installeur de l'image génère le .env pour toi)
# ============================================================

# --- OBLIGATOIRE -------------------------------------------------------------

# Mot de passe de connexion au dashboard (/dashboard). Choisis-en un long.
DASHBOARD_PASSWORD=change-moi

# Adresse publique de ton addon, SANS slash final. Utilisée pour le logo et
# les liens (/proposer...) renvoyés dans Stremio.
#   en local :        http://localhost:3000
#   avec un domaine (reverse proxy HTTPS) : https://trailers.mondomaine.fr
APP_BASE_URL=http://localhost:3000

# --- RECOMMANDÉ --------------------------------------------------------------

# Ta clé TMDB (gratuite : https://www.themoviedb.org/settings/api).
# Réservée au testeur du dashboard : les utilisateurs de l'addon mettent la leur
# dans la page de configuration.
TMDB_API_KEY=

# --- RÉSEAU (optionnel) ------------------------------------------------------

# Ton reverse proxy HTTPS tourne sur cette même machine ? Ne publie plus le port de l'addon sur Internet :
# BIND_ADDRESS=127.0.0.1

# Mets 0 si l'addon est exposé DIRECTEMENT sur Internet (sans reverse proxy devant) : ignore alors
# l'en-tête X-Forwarded-For (falsifiable). Laisse vide derrière un reverse proxy. (l'installeur le fait pour toi.)
# TRUST_PROXY=0

# Port exposé sur la machine hôte (défaut 3000).
# HOST_PORT=3000

# Base SQLite : fichier addon.sqlite stocké dans DATA_DIR (/data dans l'image, à monter en volume).
# DATA_DIR=/data

# Dashboard : désactiver le cache de rendu (utile quand tu modifies dashboard/*)
# DASHBOARD_NO_CACHE=1

# --- CATALOGUE NETFLIX LOCAL (optionnel) ----------------------------------------
# Base locale ID Netflix <-> IMDB/TMDB (Wikidata + TMDB discover, catalogue France), mise à jour toutes les 6 h.
# Utilise TMDB_API_KEY ci-dessus. NETFLIX_SYNC=0 désactive tout ; NETFLIX_COUNTRY=fr (pays) ;
# NETFLIX_TMDB_FULL_PAGES = profondeur du 1er remplissage TMDB par type (20 titres/page, 100 par défaut, 500 max).
# NETFLIX_SYNC=1
# NETFLIX_TMDB_FULL_PAGES=100

# --- BANDES-ANNONCES NETFLIX VIA UNE AUTRE INSTANCE (optionnel) ------------------
# Récupère les bandes-annonces Netflix d'une instance de l'addon « Netflix Catalogue »
# (API de fédération /api/trailers) au lieu de scraper netflix.com.
# URL de base SANS slash final + la clé API (API_KEY) configurée sur cette instance.
# NETFLIX_FEDERATION_URL=https://netflix.mondomaine.fr
# NETFLIX_FEDERATION_API_KEY=la-cle-api-de-l-instance-amont
# Délai maximal d'un appel à l'amont, en millisecondes (6000 par défaut).
# NETFLIX_FEDERATION_TIMEOUT_MS=6000
